import streamlit as st
import pandas as pd
import random

def robot_tendances():
    st.subheader("📈 Robot de Suivi des Tendances")
    st.write("Analyse des requêtes de recherche et des réseaux sociaux en temps réel.")
    
    # Simulation de données de tendances
    data_tendances = {
        "Produit": ["Gourde Isotherme Connectée", "Mini Projecteur LED", "Crème Barrière Escargot", "Correcteur de Posture"],
        "Croissance": ["+145%", "+92%", "+80%", "+65%"],
        "Intérêt Actuel": [98, 85, 72, 60],
        "Plateforme Source": ["TikTok / Google", "Instagram", "TikTok", "Pinterest"]
    }
    df_tendances = pd.DataFrame(data_tendances)
    
    # Affichage des métriques clés
    col1, col2 = st.columns(2)
    with col1:
        st.metric(label="Niche Explosive du Jour", value="Gourde Isotherme", delta="+145% ce matin")
    with col2:
        st.metric(label="Volume Global e-com", value="Stable", delta="0.5%")
        
    st.dataframe(df_tendances, use_container_width=True)
